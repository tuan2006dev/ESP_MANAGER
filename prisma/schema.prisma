generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  TEAM_CAPTAIN
  MEMBER
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
  MISSED
}

enum ResultType {
  WIN
  TOP_2
  TOP_3
  TOP_5
  TOP_10
  OTHER
}

enum Severity {
  WARNING
  MINOR
  MAJOR
  CRITICAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REMINDER
  REPORT_APPROVED
  REPORT_REJECTED
  BONUS_AWARDED
  VIOLATION_ISSUED
  GENERAL
}

// ============================================
// AUTH & USER
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(MEMBER)

  accounts        Account[]
  sessions        Session[]
  teamMembers     TeamMember[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  approvedResults MatchResult[]  @relation("ApprovedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// TEAM & MEMBERS
// ============================================

model Team {
  id       String     @id @default(cuid())
  name     String     @unique
  logo     String?
  status   TeamStatus @default(ACTIVE)
  joinDate DateTime   @default(now())

  members    TeamMember[]
  taskTeams  TaskTeam[]
  salaries   Salary[]
  bonuses    Bonus[]
  revenues   Revenue[]
  expenses   Expense[]
  violations Violation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  nickname String
  gameUid  String?
  isActive Boolean  @default(true)
  joinDate DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  playerResults MatchPlayerResult[]
  bonuses       Bonus[]
  violations    Violation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
}

// ============================================
// TASKS & ASSIGNMENTS
// ============================================

model Task {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  date         DateTime
  time         String? // e.g. "20:05"
  map          String?
  roomId       String?
  roomPassword String?
  requirements String?  @db.Text
  entryFee     Float    @default(0) // Tiền đăng ký / Phí slot tham gia trận/giải (VNĐ)

  taskTeams TaskTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskTeam {
  id     String     @id @default(cuid())
  taskId String
  teamId String
  status TaskStatus @default(PENDING)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchResult MatchResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, teamId])
}

// ============================================
// MATCH RESULTS
// ============================================

model MatchResult {
  id         String     @id @default(cuid())
  taskTeamId String     @unique
  rank       Int
  totalKills Int
  resultType ResultType
  prizeMoney Float      @default(0) // Tiền giải thưởng đạt được (VNĐ)
  screenshot String?    @db.Text
  note       String?    @db.Text

  submittedAt  DateTime  @default(now())
  approvedAt   DateTime?
  approvedById String?

  taskTeam      TaskTeam            @relation(fields: [taskTeamId], references: [id], onDelete: Cascade)
  approvedBy    User?               @relation("ApprovedBy", fields: [approvedById], references: [id])
  playerResults MatchPlayerResult[]
}

model MatchPlayerResult {
  id            String @id @default(cuid())
  matchResultId String
  teamMemberId  String
  kills         Int    @default(0)

  matchResult MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  teamMember  TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([matchResultId, teamMemberId])
}

// ============================================
// FINANCE
// ============================================

model SalaryPolicy {
  id              String  @id @default(cuid())
  name            String
  baseSalary      Float
  currency        String  @default("VND")
  requirements    String? @db.Text
  minTasks        Int     @default(0)
  minWinrate      Float   @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Salary {
  id     String        @id @default(cuid())
  teamId String
  month  String // Format: YYYY-MM
  amount Float
  status PaymentStatus @default(PENDING)
  note   String?       @db.Text

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, month])
}

model Bonus {
  id           String        @id @default(cuid())
  name         String
  reason       String?       @db.Text
  amount       Float
  month        String // Format: YYYY-MM
  status       PaymentStatus @default(PENDING)
  teamId       String
  teamMemberId String?

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Revenue {
  id     String   @id @default(cuid())
  teamId String
  amount Float
  source String
  date   DateTime
  note   String?  @db.Text

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id       String   @id @default(cuid())
  teamId   String?
  amount   Float
  category String
  date     DateTime
  note     String?  @db.Text

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// VIOLATIONS
// ============================================

model Violation {
  id           String   @id @default(cuid())
  teamId       String
  teamMemberId String?
  description  String   @db.Text
  severity     Severity
  proof        String?  @db.Text
  date         DateTime @default(now())

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// NOTIFICATIONS & LOGS
// ============================================

model Notification {
  id      String           @id @default(cuid())
  userId  String
  title   String
  message String           @db.Text
  type    NotificationType @default(GENERAL)
  isRead  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id      String  @id @default(cuid())
  userId  String
  action  String
  details String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ============================================
// SETTINGS
// ============================================

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
